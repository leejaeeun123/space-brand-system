# 합정 에이전트 설정. 이 파일을 복사해 .env 를 만든다.
#   cp .env.example .env
#
# ⚠️ .env 는 커밋하지 않는다(.gitignore 에 등록돼 있다).

# Supabase — service_role 키다. anon 키가 아니다.
# devices/device_state/device_commands 는 RLS가 켜져 있고 정책이 없어 anon 으로는 못 만진다.
# 이 키를 들고 있다는 건 이 맥이 신뢰 경계라는 뜻이다 — 노트북을 잃어버리면 키를 회전시켜야 한다.
# 위치: Supabase 대시보드 → Project Settings → API → service_role
SUPABASE_URL=https://sewqusncgznypjigmfde.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 로컬 mosquitto. 이 프로세스가 같은 맥에서 도니 localhost 다.
MQTT_URL=mqtt://localhost:1883

# mosquitto 인증 정보. mosquitto_passwd 로 만든 계정과 같아야 한다.
# **Tasmota 기기에도 같은 값**을 넣는다(MqttUser / MqttPassword).
MQTT_USER=typelounge
MQTT_PASSWORD=
